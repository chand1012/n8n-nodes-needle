{
  "name": "n8n-nodes-needle",
  "version": "0.2.0",
  "description": "Local Cactus Needle 2 tool calling and text classification for n8n",
  "license": "MIT",
  "homepage": "https://github.com/chand1012/n8n-nodes-needle",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "needle",
    "cactus",
    "tool-calling",
    "local-ai"
  ],
  "author": {
    "name": "Chandler"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chand1012/n8n-nodes-needle.git"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && n8n-node build && node scripts/copy-assets.mjs",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "node --import tsx --test test/**/*.test.ts",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [],
    "nodes": [
      "dist/nodes/Needle/Needle.node.js",
      "dist/nodes/NeedleTextClassifier/NeedleTextClassifier.node.js",
      "dist/nodes/NeedleChatModel/NeedleChatModel.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/ai-node-sdk": "0.14.1",
    "@n8n/node-cli": "0.33.1",
    "eslint": "9.29.0",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@n8n/ai-node-sdk": "*",
    "n8n-workflow": "*"
  }
}
